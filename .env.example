# Copy to .env.local and fill in. Never commit real values.

# Qloo hackathon API key (from the Qloo Agentic Hackathon key request form).
# Only works against https://hackathon.api.qloo.com
QLOO_API_KEY=
# Optional override; defaults to the hackathon base URL.
# QLOO_BASE_URL=https://hackathon.api.qloo.com

# Ticketmaster Discovery API consumer key (developer.ticketmaster.com > My Apps).
TICKETMASTER_API_KEY=

# LLM for the conversational agent; the structured form works without any.
# Google: one or more comma-separated keys. The agent rotates to the next key or model
# when one is rate limited, overloaded or refused.
GOOGLE_GENERATIVE_AI_API_KEYS=
# GOOGLE_GENERATIVE_AI_API_KEY=   # single-key alternative
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: pick the provider/model explicitly.
# UNDERTOW_LLM_PROVIDER=google        # google | openai | anthropic
# UNDERTOW_LLM_MODEL=gemini-3.5-flash,gemini-3.8-flash   # comma-separated fallback order

# Optional: time budget for Qloo performer lookups per analysis (ms, default 25000).
# UNDERTOW_LOOKUP_BUDGET_MS=25000

# Optional: force demo data even when keys are present (e.g. offline presentations).
# UNDERTOW_FORCE_DEMO=1

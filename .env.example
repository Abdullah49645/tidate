# Copy to .env.local and fill in. Never commit real values.

# Qloo hackathon API key (from the Qloo Agentic Hackathon key request form).
# Only works against https://hackathon.api.qloo.com
QLOO_API_KEY=
# Optional override; defaults to the hackathon base URL.
# QLOO_BASE_URL=https://hackathon.api.qloo.com

# Ticketmaster Discovery API consumer key (developer.ticketmaster.com > My Apps).
TICKETMASTER_API_KEY=

# LLM for the conversational agent; the structured form works without any.
# Google: one or more comma-separated keys. The agent rotates to the next key or model
# when one is rate limited, overloaded or refused.
GOOGLE_GENERATIVE_AI_API_KEYS=
# GOOGLE_GENERATIVE_AI_API_KEY=   # single-key alternative
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: pick the provider/model explicitly.
# TIDATE_LLM_PROVIDER=google        # google | openai | anthropic
# TIDATE_LLM_MODEL=gemini-3.5-flash,gemini-3.8-flash   # comma-separated fallback order

# Optional: time budget for Qloo performer lookups per analysis (ms, default 30000).
# TIDATE_LOOKUP_BUDGET_MS=30000

# Optional: time budget for a night search, which has many more performers (ms, default 45000).
# TIDATE_DISCOVER_BUDGET_MS=45000

# Optional: force demo data even when keys are present (e.g. offline presentations).
# TIDATE_FORCE_DEMO=1

# Watches and the shared performer-match cache: Upstash Redis (free tier).
# Adding Upstash from the Vercel Marketplace sets KV_REST_API_URL and KV_REST_API_TOKEN.
# Without them, watches live in memory (fine locally, lost on restart).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=      # alternative names, if you create the database on upstash.com
# UPSTASH_REDIS_REST_TOKEN=

# Daily watch checks (vercel.json cron). Vercel sends it as "Authorization: Bearer <value>".
# Any random string of 16+ characters.
# CRON_SECRET=
